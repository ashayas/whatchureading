{
  "name": "whatchureading",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/config-check.mjs && npm run build && wrangler dev --port 8787",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "cf:typegen": "node scripts/config-check.mjs && wrangler types",
    "db:local": "node scripts/config-check.mjs && wrangler d1 migrations apply DB --local",
    "db:remote": "node scripts/config-check.mjs && wrangler d1 migrations apply DB --remote",
    "deploy": "node scripts/deploy.mjs",
    "deploy:browser": "node scripts/deploy-browser.mjs",
    "test": "cargo test",
    "test:integration": "node scripts/integration.mjs",
    "build:api": "worker-build --release",
    "test:browser": "node scripts/browser.mjs",
    "format": "prettier --write src scripts vite.config.ts",
    "setup": "node scripts/setup.mjs",
    "selfhost": "node scripts/selfhost-entry.mjs",
    "check:public": "node scripts/check-public.mjs"
  },
  "dependencies": {
    "@supabase/auth-js": "^2.117.3",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@cloudflare/playwright": "^1.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ashayas/whatchureading.git"
  }
}
