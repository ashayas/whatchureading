# Private runtime configuration. Copy to .env and fill in locally; never commit .env.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
# Optional custom domain; omit for workers.dev-only deployments.
CF_CUSTOM_DOMAIN=
# Optional management token for disposable authentication tests, never deployed.
SB_TOKEN=
# Tests default to local D1. Remote tests additionally require TEST_ALLOW_REMOTE=1.
# TEST_BASE_URL=http://127.0.0.1:8787
