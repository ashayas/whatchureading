{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whatchureading",
  "main": "build/index.js",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whatchureading-db",
      "database_id": "YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "build": {
    "command": "PATH=\"$HOME/.cargo/bin:$PATH\" worker-build --release",
    "watch_dir": "worker"
  },
  "account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID"
}
