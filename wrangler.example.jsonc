{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whatchureading",
  "main": "build/index.js",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whatchureading-db",
      "database_id": "YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    },
    {
      "binding": "OPENLIBRARY",
      "database_name": "whatchureading-openlibrary",
      "database_id": "YOUR_OPENLIBRARY_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "YOUR_R2_UPLOADS_BUCKET_NAME"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "build": {
    "command": "PATH=\"$HOME/.cargo/bin:$PATH\" worker-build --release",
    "watch_dir": "worker"
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ],
  "account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID"
}
